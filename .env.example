# Copia este archivo como .env y ajusta los valores. El .env nunca se sube a GitHub.

# --- Proveedor del LLM: ollama | gemini | openai -------------------------------
LLM_PROVIDER=gemini
OLLAMA_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_NUM_CTX=16384

# Opcionales (API privada). Los IDs de modelo caducan: revisa la documentación.
GEMINI_MODEL=gemini-3.6-flash
GOOGLE_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# --- Muestreo y contexto (régimen Q1 de la Clase 4) ---------------------------
LLM_TEMPERATURE=0.0
LLM_TOP_P=0.1
MAX_CONTEXT_TOKENS=12000

# --- Scraper ------------------------------------------------------------------
SCRAPER_BASE_URL=https://www.riopaila-castilla.com
COMPANY_NAME=Riopaila Castilla S.A.
SCRAPER_DELAY=1.0
SCRAPER_TIMEOUT=15
SCRAPER_MAX_PAGES=400
SCRAPER_MIN_CHARS=200

# ============================ Módulo 2 · agente ==============================
# LLM del agente (necesita tool calling): gemini recomendado; ollama como opción local.
# Router: reglas | llm | hibrido (reglas primero; el LLM solo desempata)
ROUTER_MODE=hibrido

# Embeddings (Clase 6): ollama (nomic-embed-text-v2-moe, local) | gemini (gemini-embedding-001) | fake (pruebas)
EMBED_PROVIDER=ollama
OLLAMA_EMBED_MODEL=nomic-embed-text-v2-moe
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_DIMS=768

# Qdrant (Clase 7): vacío = embebido en data/qdrant (sin Docker). Con Docker: http://localhost:6333
QDRANT_URL=
QDRANT_COLLECTION=riopaila_chunks
RAG_TOP_K=5
RAG_CANDIDATES=20
RAG_INCLUDE_ADVERSARIAL=1

# Memoria: SqliteSaver (corto plazo) + SqliteStore (largo plazo) en data/memory/
SUMMARY_TRIGGER_TOKENS=6000
SUMMARY_KEEP_MESSAGES=8
DIRECT_HISTORY_TOKENS=2000

# LangSmith (observabilidad: observa, no orquesta). Crea la clave en https://smith.langchain.com
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=riopaila-agente-m2
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Frontend que puede llamar a la API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------------------------------------
