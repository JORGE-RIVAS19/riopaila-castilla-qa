# Copia este archivo como .env y ajusta los valores. El .env nunca se sube a GitHub.

# --- Proveedor del LLM: ollama | gemini | openai -------------------------------
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_NUM_CTX=16384

# Opcionales (API privada). Los IDs de modelo caducan: revisa la documentación.
GEMINI_MODEL=gemini-3.6-flash
GOOGLE_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# --- Muestreo y contexto (régimen Q1 de la Clase 4) ---------------------------
LLM_TEMPERATURE=0.0
LLM_TOP_P=0.1
MAX_CONTEXT_TOKENS=12000

# --- Scraper ------------------------------------------------------------------
SCRAPER_BASE_URL=https://www.riopaila-castilla.com
COMPANY_NAME=Riopaila Castilla S.A.
SCRAPER_DELAY=1.0
SCRAPER_TIMEOUT=15
SCRAPER_MAX_PAGES=400
SCRAPER_MIN_CHARS=200
