# .env del SERVIDOR (cópialo a /opt/riopaila/.env y llena las keys). Nunca se sube a GitHub.
# --- LLM en la nube (Módulo 3: nada de Ollama como motor) ---
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
LLM_FALLBACK_PROVIDER=gemini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
ROUTER_MODE=hibrido
ROUTER_PROVIDER=deepseek
VISION_PROVIDER=gemini

# --- Embeddings locales (permitido: solo vectorizan, no razonan) y Qdrant embebido ---
EMBED_PROVIDER=ollama
OLLAMA_EMBED_MODEL=nomic-embed-text-v2-moe
OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- Taller Castilla (datos reales: solo en este servidor) ---
TALLER_DB=/opt/riopaila/data/taller/taller.duckdb
TALLER_NOVEDADES_DB=/opt/riopaila/data/taller/novedades.sqlite
MANUALES_DIR=/opt/riopaila/data/manuales
MEDIA_DIR=__HOME__/.openclaw/workspace/media
# Quién puede registrar novedades (número sin espacios = rol). El resto queda como invitado (solo consulta).
TALLER_ROLES=jorge=supervisor,+57XXXXXXXXXX=supervisor,+57YYYYYYYYYY=tecnico
TALLER_ROL_DEFECTO=invitado

# --- Observabilidad (opcional) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=riopaila-m3-taller
